import wollok.game.*

program juego {
  game.width(15)
  game.height(7)
  game.cellSize(75)
  game.boardGround("FondoDesierto.png")
  game.title("Juego")

  // Usamos addVisual en vez de addVisualCharacter para tener control total del movimiento
  game.addVisual(escalera)
  game.addVisual(personaje)
  game.addVisual(textoDeInicio)
  game.addVisual(invisible)
  game.addVisual(huesped)


  // quitar "//" si quieren poner el sonido
  // const ambienteViento = game.sound("sonido-de-viento.wav")
  // ambienteViento.shouldLoop(true)
  // ambienteViento.volume(0.1)
  // game.schedule(500, { ambienteViento.play()} )
  
 // game.schedule(3000, { game.removeVisual(textoDeInicio) })

  game.schedule(500, { game.say(personaje, "Busquemos pistas") })

  // Cuando el personaje colisiona con la caja
  game.onCollideDo(personaje, { elemento =>
    elemento.recibirColisionDe(personaje)
  })

  // Al presionar 'e', cargamos o descargamos la caja (HAY QUE ESTAR CERCA)
  keyboard.e().onPressDo({ 
    caja.cargarOAlternar() 
  })

  // Al presionar 'h', hablamos con el huesped 
  keyboard.h().onPressDo({ 
    personaje.hablarPrimerHuesped()
  })

  // Al presionar 's', bajamos al deposito
  keyboard.s().onPressDo({ 
    personaje.bajarAlDeposito()
    
  })



  // Movimiento manual con las flechas del teclado
  keyboard.up().onPressDo({ personaje.moverseA(personaje.position().up(1)) })
  keyboard.down().onPressDo({ personaje.moverseA(personaje.position().down(1)) })
  keyboard.left().onPressDo({ personaje.moverseA(personaje.position().left(1)) })
  keyboard.right().onPressDo({ personaje.moverseA(personaje.position().right(1)) })

  game.start()
}

object colores {
  const property negro = "000000"
}

object textoDeInicio {

  var texto = "Objetivo: Habla con algun huesped"

  method position() = game.at(2, 6)
  method text() = texto
  method textColor() = colores.negro()

  method cambiarTexto(nuevoTexto) {
    texto = nuevoTexto
    
  }

}

 object invisible {
  method position() = game.origin()

// method recibirColisionDe(personaje) {
//    game.say(personaje, "Cuidado!")   
// } 
}

object personaje {
  var property position = game.origin()

  method image() = "Iron Spiderman.png"

  // Método que mueve al personaje y arrastra la caja si está cargada
  method moverseA(nuevaPosicion) {
    position = nuevaPosicion
    
    // Si la caja está cargada por el personaje, la movemos con él (por ejemplo, un casillero arriba)
    if (caja.cargadaPorPersonaje()) {
      caja.position(nuevaPosicion.up(1))
    }
  }

  method hablarPrimerHuesped() {
    if(self.position().distance(huesped.position()) < 1){
      hablarConPrimerHuesped.hablar()
    }
  }

  method bajarAlDeposito() {
    if(self.position() == escalera.position()){
      deposito.entrarAlDeposito()
    }
    
  }

}

// para hacer mas huespedes podemos hacer una clase
object huesped {
  var property position = game.at(13, 5)

  method image() = "pixel_character.png"


}

object hablarConPrimerHuesped {
  // cada vez q se aprete la 'h' cambia el dialogo
  var turnoDeHablar = 0
  method hablar() {

    if(turnoDeHablar == 0){
      game.say(huesped, "Estas buscando algo?")
    } else if (turnoDeHablar == 1){
      game.say(personaje, "Sí, investigo una desaparicion")
    } else {
      game.say(huesped, "Quizas encuentres algo en el deposito del hotel")
      textoDeInicio.cambiarTexto("Objetivo: Ve al deposito")
    }

    turnoDeHablar += 1
    
  }

}

object caja {
  var property position = game.center()
  var property cargadaPorPersonaje = false

  method image() = "Caja.png"

  method cargarOAlternar() {
    // Si el personaje está en la misma posición o al lado, alternamos el estado de carga
    if (personaje.position().distance(position) <= 1) {
      cargadaPorPersonaje = not cargadaPorPersonaje
      
      if (cargadaPorPersonaje) {
        // Al cargarla, la posicionamos inmediatamente arriba del personaje
        position = personaje.position().up(1)
      }
    }
  }


}

object escalera {
  var property position = game.at(1, 5)

  method image() = "stairs.png"

  method recibirColisionDe(personaje) {
    game.say(personaje, "¿Bajamos al deposito? (S)")
  }

}

object carta {
  var property position = game.center()

  method image() = "written_paper.png"

  method recibirColisionDe(personaje) {
    game.say(personaje, "Aqui hay una carta")
  }

}

object deposito {
  method entrarAlDeposito() {
    game.removeVisual(escalera)
    game.removeVisual(invisible)
    game.removeVisual(huesped)

    game.addVisual(carta)
    game.addVisual(caja)

    
    textoDeInicio.cambiarTexto("Objetivo: Busca alguna pista del incidente")
  }

}